{
  "name": "hermes-agent-vscode",
  "displayName": "Hermes Agent",
  "description": "Hermes Agent integration for VS Code — full TUI, multi-agent, session history, profile switching, and native file/diff integration",
  "version": "0.1.0",
  "publisher": "varunsahni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varunsahni/hermes-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "hermes",
    "ai",
    "agent",
    "llm",
    "nous-research",
    "coding-assistant"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes-sidebar",
          "title": "Hermes Agent",
          "icon": "media/hermes.svg"
        }
      ]
    },
    "views": {
      "hermes-sidebar": [
        {
          "id": "hermes.sessions",
          "name": "Sessions"
        },
        {
          "id": "hermes.profiles",
          "name": "Profiles"
        }
      ]
    },
    "commands": [
      {
        "command": "hermes.newAgent",
        "title": "Hermes: New Agent",
        "icon": "$(add)"
      },
      {
        "command": "hermes.newAgentProfile",
        "title": "Hermes: New Agent (Select Profile)",
        "icon": "$(server)"
      },
      {
        "command": "hermes.resumeSession",
        "title": "Hermes: Resume Session",
        "icon": "$(play)"
      },
      {
        "command": "hermes.refreshSessions",
        "title": "Hermes: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "hermes.switchProfile",
        "title": "Hermes: Switch Profile",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "hermes.openSettings",
        "title": "Hermes: Settings"
      },
      {
        "command": "hermes.stopAgent",
        "title": "Hermes: Stop Active Agent"
      },
      {
        "command": "hermes.stopAllAgents",
        "title": "Hermes: Stop All Agents"
      },
      {
        "command": "hermes.openDiff",
        "title": "Hermes: Open Diff View",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hermes.newAgent",
          "when": "view == hermes.sessions",
          "group": "navigation"
        },
        {
          "command": "hermes.refreshSessions",
          "when": "view == hermes.sessions",
          "group": "navigation"
        },
        {
          "command": "hermes.switchProfile",
          "when": "view == hermes.profiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "hermes.resumeSession",
          "when": "view == hermes.sessions && viewItem == session",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Hermes Agent",
      "properties": {
        "hermes.executablePath": {
          "type": "string",
          "default": "hermes",
          "description": "Path to the hermes executable. Defaults to 'hermes' on PATH."
        },
        "hermes.useTui": {
          "type": "boolean",
          "default": true,
          "description": "Use the full TUI (--tui flag). Disable for a plain terminal session."
        },
        "hermes.defaultProfile": {
          "type": "string",
          "default": "",
          "description": "Default profile to use when starting new agents. Leave empty for the default profile."
        },
        "hermes.autoOpenFileLinks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and make file paths in terminal output clickable."
        },
        "hermes.sessionLimit": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of sessions to show in the sidebar."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "title": "Hermes Agent",
          "id": "hermes.terminal"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}